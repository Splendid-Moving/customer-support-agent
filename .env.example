# ── Models ─────────────────────────────────────────────
# openai = testing. openrouter = destination.
MODEL_BACKEND=openai
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# ── Lead email ─────────────────────────────────────────
# Estimate and long-distance forms are emailed here and a
# manager contacts the customer. Reuse the Resend account
# from ghl_calendar_sync.
RESEND_API_KEY=
# MUST be on a domain verified in Resend or every send 403s.
RESEND_FROM=Splendid Moving Chat <chat@splendidmoving.com>
# Comma-separated for more than one manager.
LEAD_NOTIFY_EMAIL=info@splendidmoving.com

# ── Storage ────────────────────────────────────────────
# Where a paused form is kept. On Railway this MUST point at
# a mounted volume, or every deploy loses half-filled forms.
CHECKPOINT_DB=/data/support_threads.sqlite
# Photos, held between upload and the lead email.
UPLOAD_DIR=/data/uploads

# ── Safety ─────────────────────────────────────────────
# true  = the lead email is logged in full, never sent
# false = LIVE. real email lands in the office inbox.
DRY_RUN=true

# ── Observability ──────────────────────────────────────
# ⚠️  OFF BY DEFAULT ON PURPOSE. Tracing uploads run contents
# to LangSmith — for this agent that is customer names, phone
# numbers, addresses and photos of their belongings.
# Read them at https://smith.langchain.com
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=

# Use DIFFERENT projects for local and Railway, or test runs
# and real customers end up in one undifferentiated list.
#   local   -> splendid-support-agent-dev
#   Railway -> splendid-support-agent
LANGSMITH_PROJECT=splendid-support-agent

# Keep the timings and the shape of each run, drop the contents.
LANGSMITH_HIDE_INPUTS=false
LANGSMITH_HIDE_OUTPUTS=false

# ── Knowledge base ─────────────────────────────────────
# Defaults to ./knowledge. Only set this to point the agent
# at a different folder (the tests do).
# KNOWLEDGE_DIR=
